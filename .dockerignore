*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/
*.egg

# Virtual environments
venv/
env/
ENV/
.venv

# Testing
.pytest_cache/
test_*.py
tests/
.coverage
htmlcov/

