# Helf Environment Configuration

# Host path for data storage (used by docker-compose mount and dev server)
HELF_DATA_PATH=/mnt/helf/data

# Data directory for TinyDB (container path, usually /app/data)
DATA_DIR=/app/data

# MQTT ingest — RETIRED by plan 0015 and off unless MQTT_ENABLED is set.
# The scale is read from the browser over Web Bluetooth. This path is kept as
# the fallback for a scale the browser cannot read (the decoder handles the
# Bluetooth SIG profile only; openScale drives about a hundred scales).
# MQTT_ENABLED=true
MQTT_BROKER_HOST=host.docker.internal
MQTT_BROKER_PORT=1883

# CORS origins (comma-separated or *)
CORS_ORIGINS=*

# Production mode
PRODUCTION=true

# BodySpec API Key
BODYSPEC_TOKEN=""
